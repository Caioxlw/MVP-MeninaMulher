// Prisma Schema para MVP Menina Mulher
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Papel de acesso ao painel administrativo (RF11)
enum Role {
  ADMIN
}

// Status do pedido no fluxo WhatsApp -> Painel (RF14, RF15)
enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Usuária administradora (Empresária - RF11, RNF05)
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Categorias de produtos do catálogo (RF03, US02)
model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Produtos do catálogo (RF01, RF02, RF12, US01, US07, US11)
model Product {
  id          String           @id @default(uuid())
  name        String
  description String?
  price       Decimal          @db.Decimal(10, 2)
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([active, featured])
}

// Galeria de fotos de cada produto (RF04, RF12, RNF07)
model ProductImage {
  id        String   @id @default(uuid())
  url       String
  altText   String?
  position  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

// Variações de tamanho, cor e estoque por produto (RF04, RF05, RF13, RNF09)
model ProductVariant {
  id         String      @id @default(uuid())
  size       String
  color      String
  stock      Int         @default(0)
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

// Pedidos enviados ao WhatsApp (RF08, RF14, RF15, RNF06 - sem dados pessoais de clientes)
model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique @default(autoincrement())
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, createdAt])
}

// Itens de cada pedido com snapshot de preço unitário (RF07, RF08, RF14, RF15)
model OrderItem {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity  Int
  unitPrice Decimal        @db.Decimal(10, 2)

  @@index([orderId])
  @@index([variantId])
}
