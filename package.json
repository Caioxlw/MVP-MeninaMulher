{
  "name": "mvp-menina-mulher",
  "version": "1.0.0",
  "private": true,
  "description": "MVP Menina Mulher - Full-Stack Express, React & PostgreSQL",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "lint:backend": "npm --prefix backend run lint",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:studio": "npm --prefix backend run prisma:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
