{
  "name": "mvp-menina-mulher",
  "version": "1.0.0",
  "private": true,
  "description": "MVP Menina Mulher - Full-Stack Express, React & PostgreSQL",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {

    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:generate": "npm --prefix backend run prisma:generate",
    "db:studio": "npm --prefix backend run prisma:studio"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
